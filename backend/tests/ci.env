# Environment variables used ONLY during CI testing.
# These never touch a real MySQL or Ollama — all services are mocked.
MYSQL_URL=sqlite+aiosqlite:///:memory:
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
SECRET_KEY=ci-test-secret-key-that-is-32ch!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=10
CHROMA_PATH=/tmp/chroma_ci
UPLOAD_PATH=/tmp/uploads_ci
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=200
CHUNK_OVERLAP=30
TOP_K=5
MAX_PDF_SIZE=10485760
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ci.local
